{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIO Enroll",
  "version": "0.1.0",
  "identifier": "com.aioapp.enroll",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AIO Enroll",
        "width": 1000,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "platform-tools/*"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}
